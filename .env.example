# TERAGON AI BUSINESS OS — server-side environment variables (Netlify Functions only)
# Never commit real values. The browser bundle must never contain any of these.

# AI provider (Connected Mode). Leave unset for Local Demo Mode.
AI_PROVIDER=            # e.g. anthropic | openai | none
AI_MODEL=               # central model config — no hardcoded model versions in code
AI_API_KEY=             # server-side only
AI_DAILY_BUDGET_USD=    # e.g. 5
AI_TIMEOUT_MS=          # e.g. 30000
AI_RATE_LIMIT_PER_MIN=  # e.g. 10

# Cloud repository adapter (Connected Mode, optional)
CLOUD_DB_URL=
CLOUD_DB_KEY=
