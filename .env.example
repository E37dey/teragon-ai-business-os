# TERAGON AI BUSINESS OS — server-side environment variables (Phase 5.14, W5-B)
# =============================================================================
# These are read ONLY by Netlify Functions (src/server/config.ts).
# NEVER commit real values. NEVER prefix with VITE_ — anything VITE_* is
# bundled into the browser. The client bundle must never contain any of these.
# Missing values never crash the server — they yield the honest "לא הוגדר"
# health state and AI_PROVIDER_NOT_CONFIGURED errors.
#
# Where to set real values:
#   - Netlify UI: Site configuration → Environment variables (scope: Functions)
#   - Local dev:  an untracked .env used by `netlify dev` (never committed)
# See docs/AI_PROVIDER_SETUP.md for the full setup + verification guide.

# --- provider selection ------------------------------------------------------
# Which server adapter to use: test | anthropic | openai
#   test      — deterministic local adapter, no network, no key (CI/integration)
#   anthropic — Anthropic Messages API (requires AI_API_KEY + AI_MODEL)
#   openai    — OpenAI-compatible Chat Completions (requires AI_API_KEY + AI_MODEL)
# Unset ⇒ no provider ⇒ health "לא הוגדר".
AI_PROVIDER=

# The exact model identifier the provider should use. Central config — the
# code NEVER hardcodes a model name; envelope.model echoes this value.
AI_MODEL=

# Provider API key. SERVER-SIDE ONLY. Never logged (redaction guards), never
# echoed in any response, never read by client code.
AI_API_KEY=

# Optional provider base-URL override (self-hosted gateway / proxy).
# Empty ⇒ the provider's official endpoint.
AI_BASE_URL=

# --- limits & guards ---------------------------------------------------------
# Per-attempt provider timeout in milliseconds (default 20000).
AI_REQUEST_TIMEOUT_MS=

# Max output tokens requested from the provider (default 2048).
AI_MAX_OUTPUT_TOKENS=

# Daily org budget in accounting units (measured tokens when reported,
# otherwise 1 unit per request — see docs/AI_SERVER_SECURITY.md).
# Empty/0 ⇒ no budget gate.
AI_DAILY_BUDGET=

# Sliding-window request limit per minute, per user AND per session (default 10).
AI_RATE_LIMIT_PER_MINUTE=

# Max concurrent in-flight AI requests per function instance (default 4).
AI_MAX_CONCURRENT_REQUESTS=

# --- master switch -----------------------------------------------------------
# Remote AI kill switch. false (the default) ⇒ health "מושבת", every AI
# operation refuses with AI_PROVIDER_NOT_CONFIGURED, no provider is contacted.
AI_REMOTE_ENABLED=false
