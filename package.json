{
  "name": "teragon-os",
  "private": true,
  "version": "1.0.2-demo",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:supabase:live": "vitest run --config vitest.supabase-live.config.ts",
    "test:auth:live": "node scripts/run-auth-live.mjs",
    "test:staging:auth:live": "node scripts/run-auth-live.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "scan:secrets": "node scripts/scan-bundle-secrets.mjs",
    "platform:credentials": "node scripts/platform/bootstrap-credentials.mjs",
    "platform:plan": "node scripts/platform/plan.mjs",
    "platform:local": "node scripts/platform/validate-local.mjs",
    "platform:staging": "node scripts/platform/staging.mjs plan",
    "platform:staging:plan": "node scripts/platform/staging.mjs plan",
    "platform:staging:apply": "node scripts/platform/staging.mjs apply",
    "platform:verify": "node scripts/platform/verify-preview.mjs",
    "platform:production": "node scripts/platform/deploy-production.mjs",
    "platform:rollback": "node scripts/platform/rollback.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.111.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "idb": "^8.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.6",
    "supabase": "2.110.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "description": "TERAGON AI BUSINESS OS — מערכת ההפעלה החכמה לניהול טרגון"
}
