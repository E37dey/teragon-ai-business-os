# TERAGON AI BUSINESS OS — platform DEPLOY credentials (Gate S1).
# =============================================================================
# NAMES + PLACEHOLDERS ONLY. NEVER commit real values.
#   • These are consumed ONLY by the scripts/platform/** deploy orchestration
#     (Supabase Management API / CLI + Netlify), run from an operator machine.
#   • SERVER-SIDE ONLY. NEVER prefix any of these with VITE_ — a VITE_* var is
#     bundled into the browser. None of these may ever reach the client bundle.
#   • Copy to an untracked  .env.deploy  and fill in real values there.
#     Both .env.deploy and this .env.deploy.example match .gitignore's `.env.*`.
#
# The platform scripts are value-blind: they check/report these by NAME only and
# fail closed (refuse before any remote action) when a required NAME is absent.

# --- Supabase (project provisioning + migrations + admin seed) ---------------
# Personal access token for the Supabase Management API / CLI (never logged).
SUPABASE_ACCESS_TOKEN=
# Organization the staging project is created under.
SUPABASE_ORG_ID=
# Database password used when creating/linking the project (never logged).
SUPABASE_DB_PASSWORD=
# Existing project ref — OPTIONAL. If set, scripts reuse it (verify-before-create)
# instead of creating a new project.
SUPABASE_PROJECT_REF=
# OPTIONAL region for a newly created project (default eu-central-1).
SUPABASE_REGION=eu-central-1

# --- Netlify (configure site env + deploy preview/production) -----------------
# Netlify personal access token (never logged).
NETLIFY_AUTH_TOKEN=
# Linked site id (also present in .netlify/state.json). Scripts reuse it; they
# never create a second site.
NETLIFY_SITE_ID=

# --- First admin bootstrap (idempotent create-if-absent) ---------------------
TERAGON_ADMIN_EMAIL=
TERAGON_ADMIN_PASSWORD=

# --- Production gate ---------------------------------------------------------
# Hard opt-in. Production deploy REFUSES unless this is exactly "true".
DEPLOY_PRODUCTION=false
