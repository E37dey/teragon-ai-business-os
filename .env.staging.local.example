# TERAGON AI BUSINESS OS — STAGING credential TEMPLATE (S6.1).
# =============================================================================
# NAMES + PLACEHOLDERS ONLY. This example is committed; the real file it
# documents — .env.staging.local — is gitignored and NEVER committed.
#
# You normally do NOT fill this in by hand. Run:
#
#     npm run platform:credentials
#
# which resolves NETLIFY_SITE_ID from the existing Netlify link, ensures a
# Supabase authorization (env token OR authenticated CLI session), auto-selects
# the organization when only one is accessible, GENERATES the two passwords with
# a CSPRNG, resolves/prompts the admin email, and writes .env.staging.local with
# owner-only permissions. It never prints a secret value.
#
# Supabase Management-API auth is satisfied by the authenticated CLI session, so
# SUPABASE_ACCESS_TOKEN is OPTIONAL here. Set it only for headless/CI use.

# Organization the staging project is created under (auto-selected when one).
SUPABASE_ORG_ID=
# CSPRNG-generated at bootstrap; used to create/link the staging DB. Never logged.
SUPABASE_DB_PASSWORD=
# The first administrator (confirmed, never invented).
TERAGON_ADMIN_EMAIL=
# CSPRNG-generated at bootstrap; distinct from the DB password. Never logged.
TERAGON_ADMIN_PASSWORD=
# Resolved from .netlify/state.json — the EXISTING site is reused, never duplicated.
NETLIFY_SITE_ID=

# OPTIONAL — only for headless/CI where no interactive CLI session exists.
# SUPABASE_ACCESS_TOKEN=
